# Nexum — public environment variables.
# Copy to `.env.local` for local dev.

# Block 1 (GCP) runtime API endpoint.
NEXUM_API_BASE_URL=https://nexum-api-xxxxx-uc.a.run.app

# Firebase Auth (frontend config blob for client integrations when needed).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_CONFIG=

# Optional cookie key used by server-rendered requests.
# Set by your auth gateway/session handler after Firebase login.
# firebase_id_token=<id-token>

# Email address shown in the CTA / contact section.
NEXT_PUBLIC_CONTACT_EMAIL=hola@nexum.co

# Optional analytics ID (Plausible, GA4, etc.).
NEXT_PUBLIC_ANALYTICS_ID=

# Chat with your data (server-side LLM).
# Cheap default model: gpt-4.1-nano
OPENAI_MODEL=gpt-4.1-nano
OPENAI_API_KEY=

# Default (OpenAI Responses API):
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_PATH=/responses
# OPENAI_USE_CHAT_COMPLETIONS=false

# Google Cloud Vertex AI (OpenAI-compatible Chat Completions):
# OPENAI_BASE_URL=https://aiplatform.googleapis.com/v1/projects/<PROJECT_ID>/locations/global/endpoints/openapi
# OPENAI_API_PATH=/chat/completions
# OPENAI_USE_CHAT_COMPLETIONS=true
# OPENAI_API_KEY=<gcloud auth token or service-account bearer token>
