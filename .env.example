# Nexum landing — public environment variables.
# Copy to `.env.local` and fill values when needed.
# All variables consumed by the browser must be prefixed with NEXT_PUBLIC_.

# Email address shown in the CTA / contact section.
NEXT_PUBLIC_CONTACT_EMAIL=hola@nexum.co

# Optional analytics ID (e.g. Vercel Analytics, Plausible, GA4).
NEXT_PUBLIC_ANALYTICS_ID=
